---
/**
 * BaseLayout — Root document layout for Project Atlas.
 * Provides the HTML shell, skip navigation, persistent sticky header
 * with "C. Rodriguez" name link, Projects dropdown, open center space,
 * and GitHub + Email icon actions on the far right.
 *
 * Includes dynamic particulate background and view transition management.
 */

import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import PreviewModal from '../components/PreviewModal.astro';
import DynamicBackground from '../components/DynamicBackground.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'A living registry of creative engineering projects — systems visualization, design systems, agent orchestration, and developer tools.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Dynamic Particulate Background Effect -->
    <DynamicBackground />

    <!-- ------------------------------------------------------------------ -->
    <!--  Persistent Header: Name + Dropdown on Left, Icons on Far Right      -->
    <!-- ------------------------------------------------------------------ -->
    <header class="site-header">
      <div class="site-header-inner">
        <!-- Left group: Name + Category Dropdown -->
        <div class="header-left">
          <a
            href="https://voluble-babka-6e3ce5.netlify.app/#main-content"
            target="_blank"
            rel="noopener noreferrer"
            class="header-name-link"
          >
            C. Rodriguez
          </a>

          <!-- Category Filter Dropdown -->
          <div class="category-dropdown-wrapper">
            <label for="header-category-filter" class="visually-hidden">Filter Projects</label>
            <select
              id="header-category-filter"
              class="header-category-select"
              aria-label="Filter projects by category"
            >
              <option value="all">Projects</option>
              <option value="ui-systems">UI Systems &amp; Theme Kits</option>
              <option value="runtime-systems">Runtime &amp; Systems</option>
              <option value="agents-automation">Agents &amp; Automation</option>
              <option value="tools-analysis">Tools &amp; Analysis</option>
              <option value="creative-experiments">Creative Experiments</option>
              <option value="developer-tools">Developer Tools</option>
              <option value="personal-context">Portfolio &amp; Context</option>
            </select>
            <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>

        <!-- Right group: GitHub icon first, Email envelope icon furthest right -->
        <div class="header-right">
          <a
            href="https://github.com/ui-commits"
            target="_blank"
            rel="noopener noreferrer"
            class="header-icon-btn"
            aria-label="GitHub Profile & Repositories"
            title="GitHub"
          >
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
            </svg>
          </a>

          <a
            href="mailto:ui.commits@icloud.com"
            class="header-icon-btn"
            aria-label="Send email to ui.commits@icloud.com"
            title="Email"
          >
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </a>
        </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <PreviewModal />

    <!-- ------------------------------------------------------------------ -->
    <!--  Interactive Header Category Filter & Preview Controller            -->
    <!-- ------------------------------------------------------------------ -->
    <script>
      function setupAppControllers() {
        // --- 1. Category Dropdown Filter ---
        const categorySelect = document.getElementById('header-category-filter') as HTMLSelectElement | null;
        const grid = document.getElementById('project-grid');
        const emptyState = document.getElementById('empty-state') as HTMLElement | null;

        if (categorySelect) {
          // Sync with URL search params on page load
          const params = new URLSearchParams(window.location.search);
          const currentCat = params.get('category');
          if (currentCat && Array.from(categorySelect.options).some(o => o.value === currentCat)) {
            categorySelect.value = currentCat;
            applyCategoryFilter(currentCat);
          }

          categorySelect.onchange = () => {
            const selected = categorySelect.value;
            if (window.location.pathname === '/' || window.location.pathname === '') {
              // On home page: filter immediately in-place and update URL param
              applyCategoryFilter(selected);
              const newUrl = selected === 'all' ? '/' : `/?category=${encodeURIComponent(selected)}`;
              window.history.replaceState({}, '', newUrl);
            } else {
              // On other pages: navigate to index with category query
              const targetUrl = selected === 'all' ? '/' : `/?category=${encodeURIComponent(selected)}`;
              window.location.href = targetUrl;
            }
          };
        }

        function applyCategoryFilter(cat: string) {
          if (!grid) return;
          const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-category]'));
          let visibleCount = 0;

          cards.forEach((card) => {
            const match = cat === 'all' || card.dataset.category === cat;
            card.hidden = !match;
            if (match) visibleCount++;
          });

          if (emptyState) {
            emptyState.hidden = visibleCount > 0;
          }
        }

        // --- 2. Preview Modal Controller ---
        // Delegated listeners bind once per document and resolve their
        // elements at event time, so they survive Astro body swaps without
        // stacking duplicate handlers on every astro:page-load.
        const previewModalController = (() => {
          let lastFocusedElement: HTMLElement | null = null;

          function refs() {
            const modal = document.getElementById('preview-modal');
            const iframe = document.getElementById('preview-iframe') as HTMLIFrameElement | null;
            const openLink = document.getElementById('preview-open-link') as HTMLAnchorElement | null;
            const loadingIndicator = modal?.querySelector('[data-loading]') as HTMLElement | null;
            return modal && iframe && openLink && loadingIndicator
              ? { modal, iframe, openLink, loadingIndicator }
              : null;
          }

          function isOpen() {
            return (
              document.getElementById('preview-modal')?.getAttribute('aria-hidden') === 'false'
            );
          }

          function open(url: string, trigger: HTMLElement) {
            const r = refs();
            if (!r) return;

            lastFocusedElement = trigger;

            r.iframe.src = url;
            r.openLink.href = url;
            r.loadingIndicator.setAttribute('data-loading', 'true');

            r.modal.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';

            // Focus the real close button: the backdrop div also carries
            // [data-modal-close] but is not focusable.
            r.modal.querySelector<HTMLElement>('button[data-modal-close]')?.focus();
          }

          function close() {
            const r = refs();
            if (!r) return;

            r.modal.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';

            r.iframe.src = 'about:blank';

            lastFocusedElement?.focus();
            lastFocusedElement = null;
          }

          const scope = window as Window & { __atlasPreviewBound?: boolean };
          if (!scope.__atlasPreviewBound) {
            scope.__atlasPreviewBound = true;

            // Open via preview triggers; close via backdrop/close button.
            document.addEventListener('click', (e) => {
              const target = e.target as HTMLElement;

              const previewButton = target.closest('[data-preview-url]') as HTMLElement | null;
              if (previewButton) {
                e.preventDefault();
                const url = previewButton.dataset.previewUrl;
                if (url) open(url, previewButton);
                return;
              }

              if (isOpen() && target.closest('[data-modal-close]')) {
                close();
              }
            });

            // Close modal on ESC key.
            document.addEventListener('keydown', (e) => {
              if (e.key === 'Escape' && isOpen()) {
                close();
              }
            });
          }
        })();
        void previewModalController;

        // Handle iframe load to hide the loading indicator. Element-scoped,
        // so rebinding per astro:page-load is safe.
        {
          const modalEl = document.getElementById('preview-modal');
          const iframeEl = document.getElementById('preview-iframe');
          const loaderEl = modalEl?.querySelector('[data-loading]');
          if (iframeEl && loaderEl) {
            iframeEl.addEventListener('load', () => {
              loaderEl.setAttribute('data-loading', 'false');
            });
          }
        }
      }

      // Initial setup & re-binding across view transition page loads
      setupAppControllers();
      document.addEventListener('astro:page-load', setupAppControllers);
    </script>
  </body>
</html>

<style>
  /* ------------------------------------------------------------------ */
  /*  Header Layout & Components                                         */
  /* ------------------------------------------------------------------ */

  .header-left {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .header-name-link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .header-name-link:hover,
  .header-name-link:focus-visible {
    color: #6ee7b7;
  }

  .category-dropdown-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .header-category-select {
    appearance: none;
    -webkit-appearance: none;
    background-color: var(--color-surface);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.03em;
    padding: 0.35rem 1.85rem 0.35rem 0.75rem;
    border: 1px solid var(--color-contour);
    border-radius: var(--border-radius-sm);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
    outline: none;
  }

  .header-category-select:hover {
    border-color: var(--color-focus);
    background-color: var(--color-surface-strong);
    color: var(--color-ink);
  }

  .header-category-select:focus-visible {
    border-color: #6ee7b7;
    box-shadow: 0 0 0 2px rgba(110, 231, 183, 0.4);
  }

  .dropdown-chevron {
    position: absolute;
    right: 0.6rem;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ------------------------------------------------------------------ */
  /*  Header Right: Icons                                                */
  /* ------------------------------------------------------------------ */

  .header-right {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .header-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    padding: 6px;
    border-radius: var(--border-radius-sm);
    transition: color var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
  }

  .header-icon-btn:hover,
  .header-icon-btn:focus-visible {
    color: var(--color-ink);
    transform: translateY(-1px);
  }

  .header-icon-btn:focus-visible {
    outline: 2px solid #6ee7b7;
    outline-offset: 2px;
  }
</style>
