---
/**
 * Project Atlas — Home Page (Direct Project Showcase)
 * Renders all 19 unique project accessions once in a semi-transparent
 * glass container over the dynamic particulate background.
 */

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SessionStatus from '../components/SessionStatus.astro';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) =>
  a.data.registryId.localeCompare(b.data.registryId)
);
---

<BaseLayout title="Project Atlas — Creative Engineering Registry">
  <SessionStatus recordCount={sortedProjects.length} />
  <div class="atlas-stage-wrapper">
    <!-- ------------------------------------------------------------------ -->
    <!--  Semi-transparent Glass Container for the 19 Accessions            -->
    <!-- ------------------------------------------------------------------ -->
    <div class="atlas-glass-stage" id="atlas-stage">
      <div class="stage-header">
        <div class="stage-status-indicator">
          <span class="pulse-dot" aria-hidden="true"></span>
          <span class="stage-status-text">Creative Engineering Registry</span>
        </div>
        <span class="stage-count" id="active-count">[{sortedProjects.length} records]</span>
      </div>

      <div class="project-grid" id="project-grid" aria-live="polite" aria-atomic="false">
        {sortedProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>

      <!-- Empty state shown when no cards match active filter -->
      <p class="empty-state" id="empty-state" hidden aria-live="polite">
        No project records match the selected category.
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  function setupCountSync() {
    const grid = document.getElementById('project-grid');
    const countEl = document.getElementById('active-count');
    const select = document.getElementById('header-category-filter') as HTMLSelectElement | null;
    if (!grid || !countEl) return;

    function updateActiveCount() {
      if (!countEl || !grid) return;
      const visible = grid.querySelectorAll<HTMLElement>('.project-card:not([hidden])').length;
      const label = visible === 1 ? 'record' : 'records';
      countEl.textContent = `[${visible} ${label}]`;
    }

    if (select) {
      select.addEventListener('change', () => {
        setTimeout(updateActiveCount, 30);
      });
    }

    updateActiveCount();
  }

  function setupSessionStatus() {
    const state = document.getElementById('session-state');
    const message = document.getElementById('session-message');
    const blocker = document.getElementById('session-blocker');
    const next = document.getElementById('session-next') as HTMLAnchorElement | null;
    const select = document.getElementById('header-category-filter') as HTMLSelectElement | null;
    const grid = document.getElementById('project-grid');
    if (!state || !message || !blocker || !next || !grid) return;

    const sync = () => {
      const visible = grid.querySelectorAll<HTMLElement>('.project-card:not([hidden])').length;
      const selected = select?.value ?? 'all';
      state.textContent = 'Ready';
      message.textContent = selected === 'all'
        ? 'Session active · registry synchronized'
        : `Session active · ${selected} filter engaged`;
      blocker.textContent = visible === 0 ? 'No records match this filter' : '—';
      next.textContent = visible === 0 ? 'Clear the filter to continue' : 'Select an accession to descend to dossier';
      next.href = visible === 0 ? '/' : '#project-grid';
    };

    if (select && select.dataset.sessionBound !== 'true') {
      select.dataset.sessionBound = 'true';
      select.addEventListener('change', () => setTimeout(sync, 30));
    }
    sync();
  }

  setupCountSync();
  setupSessionStatus();
  document.addEventListener('astro:page-load', setupCountSync);
  document.addEventListener('astro:page-load', setupSessionStatus);
</script>

<style>
  .atlas-stage-wrapper {
    position: relative;
    z-index: 1;
    padding-block: var(--space-md) var(--space-4xl);
  }

  /* ------------------------------------------------------------------ */
  /*  Glass Container                                                    */
  /* ------------------------------------------------------------------ */

  .atlas-glass-stage {
    position: relative;
    background: rgba(31, 37, 68, 0.45);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(129, 104, 157, 0.35);
    border-radius: var(--border-radius-lg);
    padding: var(--space-lg);
    box-shadow:
      0 20px 48px rgba(10, 14, 30, 0.45),
      inset 0 1px 0 rgba(255, 208, 236, 0.12);
  }

  @media (min-width: 768px) {
    .atlas-glass-stage {
      padding: var(--space-xl);
    }
  }

  .stage-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-md);
    margin-bottom: var(--space-lg);
    border-bottom: 1px solid rgba(129, 104, 157, 0.25);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .stage-status-indicator {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-ink);
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--color-live);
    box-shadow: 0 0 8px var(--color-live);
    animation: pulse-live 2s ease-in-out infinite;
  }

  @keyframes pulse-live {
    0%, 100% {
      opacity: 0.6;
      transform: scale(0.9);
    }
    50% {
      opacity: 1;
      transform: scale(1.15);
    }
  }

  .stage-count {
    color: var(--color-text-muted);
  }

  /* ------------------------------------------------------------------ */
  /*  Grid                                                               */
  /* ------------------------------------------------------------------ */

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .project-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1440px) {
    .project-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* ------------------------------------------------------------------ */
  /*  Empty state                                                        */
  /* ------------------------------------------------------------------ */

  .empty-state {
    padding-block: var(--space-3xl);
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    border: 1px dashed var(--color-contour);
    border-radius: var(--border-radius-md);
    margin-top: var(--space-xl);
  }
</style>
