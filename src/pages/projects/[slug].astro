---
/**
 * Project Atlas — Project Detail Route (/projects/[slug])
 * Full dossier view for an individual project accession.
 */

import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusStamp from '../../components/StatusStamp.astro';
import RegistryPlate from '../../components/RegistryPlate.astro';
import ArtifactLink from '../../components/ArtifactLink.astro';
import { CATEGORY_LABELS } from '../../lib/registry';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const categoryLabel = CATEGORY_LABELS[data.category] || data.category;
---

<BaseLayout title={`${data.title} — Project Atlas (${data.registryId})`}>
  <article class="dossier">
    <!-- Breadcrumb return -->
    <nav class="dossier-nav" aria-label="Breadcrumb">
      <a href="/" class="back-link">&larr; Return to Atlas</a>
      <span class="nav-separator">/</span>
      <span class="nav-category">{categoryLabel}</span>
    </nav>

    <!-- Header / Identification -->
    <header class="dossier-header">
      <div class="dossier-meta-top">
        <span class="mono dossier-id">{data.registryId}</span>
        <span class="mono dossier-year">[{data.year}]</span>
        <StatusStamp status={data.status} />
      </div>

      <h1 class="dossier-title">{data.title}</h1>
      <p class="dossier-summary">{data.summary}</p>
    </header>

    <!-- Visual Plate / Screenshot -->
    <div class="dossier-media">
      {data.thumbnail ? (
        <img
          src={data.thumbnail.src}
          alt={data.thumbnail.alt}
          width={data.thumbnail.width}
          height={data.thumbnail.height}
          class="dossier-image"
        />
      ) : (
        <RegistryPlate
          registryId={data.registryId}
          category={data.category}
          status={data.status}
        />
      )}
    </div>

    <!-- Primary Action Bar -->
    <div class="dossier-actions">
      {data.liveUrl && (
        <a
          href={data.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
        >
          Open Live Project &#8599;
        </a>
      )}
      {data.githubUrl && (
        <a
          href={data.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary"
        >
          View Source Repository &#8599;
        </a>
      )}
    </div>

    <div class="dossier-grid">
      <!-- Main Content / Narrative -->
      <div class="dossier-main">
        <section class="dossier-section why-it-matters">
          <h2 class="section-subheading">Why It Matters</h2>
          <p>{data.whyItMatters}</p>
        </section>

        <section class="dossier-prose">
          <Content />
        </section>
      </div>

      <!-- Dossier Sidebar -->
      <aside class="dossier-sidebar">
        <!-- Artifacts Record -->
        {data.artifacts.length > 0 && (
          <section class="sidebar-block" aria-labelledby="artifacts-heading">
            <h2 id="artifacts-heading" class="sidebar-heading">Artifacts &amp; Records</h2>
            <ul class="artifacts-list" role="list">
              {data.artifacts.map((artifact) => (
                <ArtifactLink artifact={artifact} />
              ))}
            </ul>
          </section>
        )}

        <!-- Technical Tags -->
        {data.tags.length > 0 && (
          <section class="sidebar-block" aria-labelledby="tags-heading">
            <h2 id="tags-heading" class="sidebar-heading">Classification Tags</h2>
            <ul class="tags-list" role="list">
              {data.tags.map((tag) => (
                <li class="tag-pill">{tag}</li>
              ))}
            </ul>
          </section>
        )}
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .dossier {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    padding-bottom: var(--space-4xl);
  }

  .dossier-nav {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .back-link {
    color: var(--color-focus);
    text-decoration: none;
  }

  .back-link:hover,
  .back-link:focus-visible {
    text-decoration: underline;
  }

  .nav-separator {
    color: var(--color-contour);
  }

  .dossier-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    max-width: var(--content-width);
  }

  .dossier-meta-top {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .dossier-id {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
  }

  .dossier-year {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .dossier-title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
    line-height: var(--leading-tight);
  }

  .dossier-summary {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  .dossier-media {
    border-radius: var(--border-radius-md);
    overflow: hidden;
    border: 1px solid var(--color-contour);
    background-color: var(--color-surface);
  }

  .dossier-image {
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .dossier-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: var(--space-sm) var(--space-lg);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    border-radius: var(--border-radius-sm);
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out);
  }

  .btn-primary {
    background-color: var(--color-ink);
    color: var(--color-page);
    border: 1px solid var(--color-ink);
  }

  .btn-primary:hover,
  .btn-primary:focus-visible {
    background-color: var(--color-focus);
    border-color: var(--color-focus);
  }

  .btn-secondary {
    background-color: var(--color-surface);
    color: var(--color-ink);
    border: 1px solid var(--color-contour);
  }

  .btn-secondary:hover,
  .btn-secondary:focus-visible {
    background-color: var(--color-surface-strong);
    border-color: var(--color-focus);
  }

  .dossier-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  @media (min-width: 1024px) {
    .dossier-grid {
      grid-template-columns: 2fr 1fr;
    }
  }

  .dossier-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .section-subheading {
    font-size: var(--text-xl);
    margin-bottom: var(--space-sm);
  }

  .why-it-matters {
    padding: var(--space-md) var(--space-lg);
    background-color: var(--color-surface);
    border-left: 3px solid var(--color-focus);
    border-radius: 0 var(--border-radius-sm) var(--border-radius-sm) 0;
  }

  .why-it-matters p {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  .dossier-prose {
    line-height: var(--leading-relaxed);
  }

  .dossier-prose :global(h2),
  .dossier-prose :global(h3) {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
  }

  .dossier-prose :global(p) {
    margin-bottom: var(--space-md);
  }

  .dossier-prose :global(ul) {
    margin-bottom: var(--space-md);
    padding-left: var(--space-lg);
  }

  .dossier-prose :global(li) {
    margin-bottom: var(--space-xs);
  }

  .dossier-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .sidebar-heading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .artifacts-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .tag-pill {
    padding: var(--space-2xs) var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    background-color: var(--color-surface);
    border: 1px solid var(--color-contour);
    border-radius: var(--border-radius-sm);
    color: var(--color-text-muted);
  }
</style>
