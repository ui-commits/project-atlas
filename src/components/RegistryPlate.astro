---
/**
 * RegistryPlate — Fallback visual plate for cards without a thumbnail.
 * Renders a 16:10 plate with a deterministic contour texture seeded
 * by the immutable registry ID, category glyph, and accession stamp.
 */

import type { ProjectCategory, ProjectStatus } from '../schemas/project';
import StatusStamp from './StatusStamp.astro';
import { generateContourPaths } from '../lib/registry';

interface Props {
  registryId: string;
  category: ProjectCategory;
  status: ProjectStatus;
}

const { registryId, category, status } = Astro.props;
const contourPaths = generateContourPaths(registryId, 480, 300);
---

<div class="registry-plate" aria-hidden="true">
  <svg class="plate-contours" viewBox="0 0 480 300" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id={`grid-${registryId}`} width="24" height="24" patternUnits="userSpaceOnUse">
        <path d="M 24 0 L 0 0 0 24" fill="none" stroke="var(--color-contour)" stroke-width="0.5" stroke-opacity="0.35" />
      </pattern>
    </defs>
    
    <rect width="100%" height="100%" fill={`url(#grid-${registryId})`} />
    
    {contourPaths.map((d) => (
      <path d={d} fill="none" stroke="var(--color-contour)" stroke-width="1" stroke-opacity="0.6" />
    ))}
    
    <!-- Central accession watermark -->
    <circle cx="240" cy="150" r="48" fill="none" stroke="var(--color-contour)" stroke-width="0.75" stroke-opacity="0.4" stroke-dasharray="2 4" />
    <circle cx="240" cy="150" r="16" fill="none" stroke="var(--color-contour)" stroke-width="0.75" stroke-opacity="0.5" />
  </svg>

  <div class="plate-header">
    <span class="plate-id">{registryId}</span>
    <StatusStamp status={status} />
  </div>

  <div class="plate-footer">
    <span class="plate-category-badge">{category}</span>
  </div>
</div>

<style>
  .registry-plate {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-contour);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-sm) var(--space-md);
    user-select: none;
  }

  .plate-contours {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .plate-header {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .plate-id {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .plate-footer {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: flex-end;
  }

  .plate-category-badge {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    opacity: 0.85;
  }
</style>
