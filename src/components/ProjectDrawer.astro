---
/**
 * ProjectDrawer.astro
 * Slide-out drawer panel from the right side for inline project details.
 * Opened via data-project-id on card media areas.
 * Supports ESC key, click-outside-to-close, and full focus management.
 *
 * Project data is injected at runtime via JS from JSON embedded in
 * data-projects on a sibling script target — no Astro props needed here
 * since the drawer is a global singleton.
 */
---

<aside
  id="project-drawer"
  class="project-drawer"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby="drawer-title"
>
  <!-- Backdrop -->
  <div class="drawer-backdrop" data-drawer-close aria-hidden="true"></div>

  <!-- Panel -->
  <div class="drawer-panel" tabindex="-1">
    <!-- Header -->
    <div class="drawer-header">
      <div class="drawer-header-meta">
        <span class="drawer-registry-id" id="drawer-registry-id"></span>
        <span class="drawer-year" id="drawer-year"></span>
      </div>
      <button
        type="button"
        class="drawer-close"
        data-drawer-close
        aria-label="Close project drawer"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <!-- Scrollable body -->
    <div class="drawer-body">
      <!-- Title + category/status row -->
      <div class="drawer-title-block">
        <h2 class="drawer-title" id="drawer-title"></h2>
        <div class="drawer-badges" id="drawer-badges"></div>
      </div>

      <!-- Summary -->
      <section class="drawer-section" aria-label="Summary">
        <p class="drawer-summary" id="drawer-summary"></p>
      </section>

      <!-- Why it matters -->
      <section class="drawer-section" aria-labelledby="drawer-why-heading">
        <h3 class="drawer-section-heading" id="drawer-why-heading">Why It Matters</h3>
        <p class="drawer-why" id="drawer-why"></p>
      </section>

      <!-- Tags -->
      <section class="drawer-section drawer-section--tags" id="drawer-tags-section" aria-label="Tags">
        <div class="drawer-tags" id="drawer-tags" role="list"></div>
      </section>

      <!-- Artifacts -->
      <section class="drawer-section" id="drawer-artifacts-section" aria-labelledby="drawer-artifacts-heading">
        <h3 class="drawer-section-heading" id="drawer-artifacts-heading">Artifacts</h3>
        <ul class="drawer-artifacts" id="drawer-artifacts" role="list"></ul>
      </section>
    </div>

    <!-- Footer actions -->
    <div class="drawer-footer">
      <a
        id="drawer-dossier-link"
        href="#"
        class="drawer-action drawer-action--primary"
        aria-label="View full project dossier"
      >
        View Dossier
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M7 1l6 6-6 6M1 7h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a
        id="drawer-live-link"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="drawer-action drawer-action--secondary"
        aria-label="Open live site in new tab"
        hidden
      >
        Open Live Site
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M12 8v4a1 1 0 01-1 1H2a1 1 0 01-1-1V3a1 1 0 011-1h4M9 1h4v4M13 1L6 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</aside>

<style>
  /* ------------------------------------------------------------------ */
  /*  Drawer root + backdrop                                             */
  /* ------------------------------------------------------------------ */

  .project-drawer {
    position: fixed;
    inset: 0;
    z-index: 9000;
    pointer-events: none;
  }

  .project-drawer[aria-hidden="false"] {
    pointer-events: auto;
  }

  .drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(23, 51, 41, 0.45);
    backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity var(--duration-normal) var(--ease-out);
    cursor: pointer;
  }

  .project-drawer[aria-hidden="false"] .drawer-backdrop {
    opacity: 1;
  }

  /* ------------------------------------------------------------------ */
  /*  Panel                                                              */
  /* ------------------------------------------------------------------ */

  .drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 480px;
    max-width: 100vw;
    background: var(--color-page);
    border-left: 1px solid var(--color-contour);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;

    /* Ensure panel is above backdrop */
    isolation: isolate;
  }

  .project-drawer[aria-hidden="false"] .drawer-panel {
    transform: translateX(0);
  }

  /* ------------------------------------------------------------------ */
  /*  Header                                                             */
  /* ------------------------------------------------------------------ */

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-md) var(--space-lg);
    border-bottom: 1px solid var(--color-contour);
    flex-shrink: 0;
    background: var(--color-surface);
  }

  .drawer-header-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .drawer-registry-id {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .drawer-year {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .drawer-year::before {
    content: '·';
    margin-right: var(--space-sm);
    opacity: 0.5;
  }

  .drawer-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--color-contour);
    border-radius: var(--border-radius-sm);
    color: var(--color-text);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
    flex-shrink: 0;
  }

  .drawer-close:hover {
    background: var(--color-surface-strong);
    border-color: var(--color-ink);
    color: var(--color-ink);
  }

  .drawer-close:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  /* ------------------------------------------------------------------ */
  /*  Scrollable body                                                    */
  /* ------------------------------------------------------------------ */

  .drawer-body {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    scroll-behavior: smooth;
  }

  /* Custom scrollbar — subtle, on-theme */
  .drawer-body::-webkit-scrollbar {
    width: 4px;
  }

  .drawer-body::-webkit-scrollbar-track {
    background: transparent;
  }

  .drawer-body::-webkit-scrollbar-thumb {
    background: var(--color-contour);
    border-radius: 2px;
  }

  /* ------------------------------------------------------------------ */
  /*  Title block                                                        */
  /* ------------------------------------------------------------------ */

  .drawer-title-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .drawer-title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    color: var(--color-ink);
    margin: 0;
  }

  .drawer-badges {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .drawer-badge {
    display: inline-flex;
    align-items: center;
    padding: 2px var(--space-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-contour);
    border-radius: var(--border-radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .drawer-badge--status-live {
    border-color: var(--color-live);
    color: var(--color-live);
  }

  .drawer-badge--status-in-progress {
    border-color: var(--color-warning);
    color: var(--color-warning);
  }

  .drawer-badge--status-archive {
    border-color: var(--color-archive);
    color: var(--color-archive);
  }

  /* ------------------------------------------------------------------ */
  /*  Sections                                                           */
  /* ------------------------------------------------------------------ */

  .drawer-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .drawer-section-heading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0;
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-contour);
  }

  .drawer-summary {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    margin: 0;
  }

  .drawer-why {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    margin: 0;
  }

  /* ------------------------------------------------------------------ */
  /*  Tags                                                               */
  /* ------------------------------------------------------------------ */

  .drawer-section--tags {
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .drawer-tag {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2xs) var(--space-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-contour);
    border-radius: var(--border-radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  /* ------------------------------------------------------------------ */
  /*  Artifacts list                                                     */
  /* ------------------------------------------------------------------ */

  .drawer-artifacts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .drawer-artifact {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .drawer-artifact-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-contour);
    border-radius: var(--border-radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text);
    text-decoration: none;
    transition: all var(--duration-fast) var(--ease-out);
    flex: 1;
  }

  .drawer-artifact-link:hover {
    background: var(--color-surface-strong);
    border-color: var(--color-focus);
    color: var(--color-focus);
  }

  .drawer-artifact-link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .drawer-artifact-type {
    font-size: var(--text-2xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    margin-left: auto;
    flex-shrink: 0;
  }

  .drawer-artifact--private .drawer-artifact-link {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  .drawer-artifact--private .drawer-artifact-type::after {
    content: ' · private';
  }

  /* ------------------------------------------------------------------ */
  /*  Footer actions                                                     */
  /* ------------------------------------------------------------------ */

  .drawer-footer {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-lg);
    border-top: 1px solid var(--color-contour);
    flex-shrink: 0;
    background: var(--color-surface);
  }

  .drawer-action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--border-radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    transition: all var(--duration-fast) var(--ease-out);
    cursor: pointer;
  }

  .drawer-action--primary {
    background: var(--color-focus);
    border: 1px solid var(--color-focus);
    color: #fff;
    flex: 1;
    justify-content: center;
  }

  .drawer-action--primary:hover {
    background: var(--color-ink);
    border-color: var(--color-ink);
  }

  .drawer-action--primary:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .drawer-action--secondary {
    background: var(--color-surface-strong);
    border: 1px solid var(--color-contour);
    color: var(--color-text);
  }

  .drawer-action--secondary:hover {
    border-color: var(--color-focus);
    color: var(--color-focus);
  }

  .drawer-action--secondary:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  /* ------------------------------------------------------------------ */
  /*  Responsive — full screen on mobile                                */
  /* ------------------------------------------------------------------ */

  @media (max-width: 540px) {
    .drawer-panel {
      width: 100vw;
      border-left: none;
      border-top: 1px solid var(--color-contour);
      top: 10vh;
      border-radius: var(--border-radius-lg) var(--border-radius-lg) 0 0;
      transform: translateY(100%);
      /* Override the right-slide for mobile — slide up instead */
    }

    .project-drawer[aria-hidden="false"] .drawer-panel {
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) and (min-width: 541px) {
    .drawer-panel {
      width: 85vw;
    }
  }
</style>
