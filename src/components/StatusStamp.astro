---
/**
 * StatusStamp — Outline status mark for Project Atlas records.
 * Renders an outline-only, mono-spaced status indicator.
 */

import type { ProjectStatus } from '../schemas/project';
import { STATUS_LABELS } from '../lib/registry';

interface Props {
  status: ProjectStatus;
  class?: string;
}

const { status, class: className = '' } = Astro.props;
const label = STATUS_LABELS[status] || status.toUpperCase();
---

<span class={`status-stamp status-${status} ${className}`} aria-label={`Status: ${label}`}>
  {label}
</span>

<style>
  .status-stamp {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.375rem;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: var(--border-radius-sm);
    border: 1px solid currentColor;
    background: transparent;
    line-height: 1.2;
    white-space: nowrap;
  }

  .status-live {
    color: var(--color-live);
  }

  .status-in-progress {
    color: var(--color-warning);
  }

  .status-local {
    color: var(--color-text-muted);
  }

  .status-archive {
    color: var(--color-archive);
  }
</style>
