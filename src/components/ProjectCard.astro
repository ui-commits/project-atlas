---
/**
 * ProjectCard — Compact, translucent project card for the Atlas registry.
 * Features an interactive thumbnail, registry accession ID, category,
 * glowing status dot, and clamped summary.
 *
 * Clicking the thumbnail or title navigates directly to /projects/[slug].
 */

import type { CollectionEntry } from 'astro:content';
import RegistryPlate from './RegistryPlate.astro';
import { CATEGORY_LABELS } from '../lib/registry';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data, id: slug } = project;
const categoryLabel = CATEGORY_LABELS[data.category] || data.category;

/**
 * Build the Microlink screenshot embed URL for a given live URL.
 */
const microlinkScreenshotUrl = (!data.thumbnail && data.liveUrl)
  ? `https://api.microlink.io/?url=${encodeURIComponent(data.liveUrl)}&screenshot=true&meta=false&embed=screenshot.url`
  : undefined;
---

<article
  class="project-card"
  data-category={data.category}
  data-status={data.status}
  data-slug={slug}
>
  <!-- Card media: clicking navigates directly to the full project dossier -->
  <a
    href={`/projects/${slug}`}
    class="card-media"
    aria-label={`View dossier for ${data.title}`}
    transition:name={`media-${slug}`}
  >
    {data.thumbnail ? (
      /* Priority 1: explicit custom thumbnail */
      <img
        src={data.thumbnail.src}
        alt={data.thumbnail.alt}
        width={data.thumbnail.width}
        height={data.thumbnail.height}
        loading="lazy"
        decoding="async"
        class="card-thumbnail"
      />
    ) : microlinkScreenshotUrl ? (
      /* Priority 2: Microlink live screenshot — RegistryPlate shown on error */
      <div class="card-screenshot-wrapper">
        <img
          src={microlinkScreenshotUrl}
          alt={`Screenshot of ${data.title}`}
          loading="lazy"
          decoding="async"
          class="card-thumbnail card-screenshot"
          onerror="this.closest('.card-screenshot-wrapper').classList.add('screenshot-failed')"
        />
        <div class="card-screenshot-fallback" aria-hidden="true">
          <RegistryPlate
            registryId={data.registryId}
            category={data.category}
            status={data.status}
          />
        </div>
      </div>
    ) : (
      /* Priority 3: no liveUrl — RegistryPlate only */
      <RegistryPlate
        registryId={data.registryId}
        category={data.category}
        status={data.status}
      />
    )}
    <div class="card-media-hint" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      View Dossier
    </div>
  </a>

  <div class="card-body">
    <div class="card-meta">
      <span class="card-registry-id">{data.registryId}</span>
      <span class="card-category">{categoryLabel}</span>
      <span
        class={`status-dot status-dot--${data.status}`}
        title={`Status: ${data.status.toUpperCase()}`}
        aria-label={`Status: ${data.status}`}
      ></span>
    </div>

    <h3 class="card-title">
      <a href={`/projects/${slug}`} class="card-title-link">
        {data.title}
      </a>
    </h3>

    <p class="card-summary">{data.summary}</p>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: rgba(35, 42, 77, 0.45);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(129, 104, 157, 0.35);
    border-radius: var(--border-radius-md);
    overflow: hidden;
    transition: transform var(--duration-normal) var(--ease-out),
                border-color var(--duration-normal) var(--ease-out),
                box-shadow var(--duration-normal) var(--ease-out);
  }

  /* Contrasting seafoam green / luminous emerald outline on hover/touch */
  .project-card:hover,
  .project-card:focus-within {
    transform: translateY(-3px);
    border-color: #6ee7b7;
    box-shadow:
      0 0 16px rgba(110, 231, 183, 0.35),
      0 10px 28px rgba(10, 14, 30, 0.45);
  }

  .card-media {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: rgba(25, 30, 56, 0.45);
    display: block;
    padding: 0;
    border: none;
    cursor: pointer;
    position: relative;
    text-decoration: none;
  }

  /* View dossier overlay hint — appears on hover */
  .card-media-hint {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-ink);
    background: rgba(25, 30, 56, 0.78);
    backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
    pointer-events: none;
  }

  .card-media:hover .card-media-hint,
  .card-media:focus-visible .card-media-hint {
    opacity: 1;
  }

  .card-media:focus-visible {
    outline: 2px solid #6ee7b7;
    outline-offset: -2px;
  }

  .card-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-screenshot-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .card-screenshot {
    position: relative;
    z-index: 1;
  }

  .card-screenshot-fallback {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .card-screenshot-wrapper.screenshot-failed .card-screenshot {
    display: none;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-md);
    gap: var(--space-xs);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-wrap: wrap;
    margin-bottom: var(--space-2xs);
  }

  .card-registry-id {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
  }

  .card-category {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-right: auto;
  }

  /* Status Dot */
  .status-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .status-dot--live {
    background-color: #56c78e;
    box-shadow: 0 0 8px #56c78e;
  }

  .status-dot--in-progress {
    background-color: #e29647;
    box-shadow: 0 0 8px #e29647;
  }

  .status-dot--archive {
    background-color: #87988f;
  }

  .card-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    margin-bottom: var(--space-2xs);
  }

  .card-title-link {
    color: var(--color-ink);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .card-title-link:hover,
  .card-title-link:focus-visible {
    color: #6ee7b7;
    text-decoration: none;
  }

  .card-summary {
    font-size: var(--text-sm);
    color: var(--color-text);
    line-height: var(--leading-normal);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }
</style>
