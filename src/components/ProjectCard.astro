---
/**
 * ProjectCard — Compact, accessible project card for the Atlas registry.
 * Renders thumbnail or RegistryPlate, registry accession ID, category,
 * status stamp, summary clamped to 2 lines, and distinct destination actions.
 */

import type { CollectionEntry } from 'astro:content';
import RegistryPlate from './RegistryPlate.astro';
import StatusStamp from './StatusStamp.astro';
import { CATEGORY_LABELS } from '../lib/registry';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data, id: slug } = project;
const categoryLabel = CATEGORY_LABELS[data.category] || data.category;
---

<article class="project-card" data-category={data.category} data-status={data.status}>
  <div class="card-media">
    {data.thumbnail ? (
      <img
        src={data.thumbnail.src}
        alt={data.thumbnail.alt}
        width={data.thumbnail.width}
        height={data.thumbnail.height}
        loading="lazy"
        decoding="async"
        class="card-thumbnail"
      />
    ) : (
      <RegistryPlate
        registryId={data.registryId}
        category={data.category}
        status={data.status}
      />
    )}
  </div>

  <div class="card-body">
    <div class="card-meta">
      <span class="card-registry-id">{data.registryId}</span>
      <span class="card-category">{categoryLabel}</span>
      <StatusStamp status={data.status} />
    </div>

    <h3 class="card-title">
      <a href={`/projects/${slug}`} class="card-title-link">
        {data.title}
      </a>
    </h3>

    <p class="card-summary">{data.summary}</p>

    <div class="card-actions">
      <a href={`/projects/${slug}`} class="action-detail" aria-label={`View dossier for ${data.title}`}>
        Dossier &rarr;
      </a>

      <div class="action-links">
        {data.liveUrl && (
          <a
            href={data.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="action-external"
            aria-label={`Open live site for ${data.title}`}
          >
            Live &#8599;
          </a>
        )}
        {data.githubUrl && (
          <a
            href={data.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="action-external"
            aria-label={`View source code for ${data.title}`}
          >
            Source &#8599;
          </a>
        )}
      </div>
    </div>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: 1px solid var(--color-contour);
    border-radius: var(--border-radius-md);
    overflow: hidden;
    transition: transform var(--duration-normal) var(--ease-out),
                border-color var(--duration-normal) var(--ease-out),
                box-shadow var(--duration-normal) var(--ease-out);
  }

  .project-card:hover,
  .project-card:focus-within {
    transform: translateY(-2px);
    border-color: var(--color-focus);
    box-shadow: 0 4px 12px rgba(23, 51, 41, 0.08);
  }

  .card-media {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-surface-strong);
  }

  .card-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-md);
    gap: var(--space-xs);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-wrap: wrap;
    margin-bottom: var(--space-2xs);
  }

  .card-registry-id {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
  }

  .card-category {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-right: auto;
  }

  .card-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    margin-bottom: var(--space-2xs);
  }

  .card-title-link {
    color: var(--color-ink);
    text-decoration: none;
  }

  .card-title-link:hover,
  .card-title-link:focus-visible {
    color: var(--color-focus);
    text-decoration: underline;
  }

  .card-summary {
    font-size: var(--text-sm);
    color: var(--color-text);
    line-height: var(--leading-normal);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: var(--space-sm);
    flex: 1;
  }

  .card-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-xs);
    border-top: 1px solid var(--color-contour);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .action-detail {
    color: var(--color-focus);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  .action-detail:hover,
  .action-detail:focus-visible {
    text-decoration: underline;
  }

  .action-links {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .action-external {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .action-external:hover,
  .action-external:focus-visible {
    color: var(--color-ink);
    text-decoration: underline;
  }
</style>
