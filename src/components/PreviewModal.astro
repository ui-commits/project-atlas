---
/**
 * PreviewModal.astro
 * Global iframe preview modal for live project URLs.
 * Opened via data-preview-url attributes on trigger buttons.
 * Supports keyboard navigation (ESC to close) and click-outside-to-close.
 */
---

<div id="preview-modal" class="preview-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="preview-modal-title">
  <div class="preview-modal-backdrop" data-modal-close></div>
  <div class="preview-modal-container">
    <div class="preview-modal-header">
      <h2 id="preview-modal-title" class="preview-modal-title">Live Preview</h2>
      <button 
        type="button" 
        class="preview-modal-close" 
        data-modal-close
        aria-label="Close preview modal"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <div class="preview-modal-body">
      <div class="preview-modal-loading" data-loading>
        <div class="spinner"></div>
        <span class="loading-text">Loading preview...</span>
      </div>
      <iframe
        id="preview-iframe"
        class="preview-iframe"
        title="Live project preview"
        sandbox="allow-scripts allow-same-origin allow-forms allow-popups"
        loading="lazy"
      ></iframe>
    </div>
    <div class="preview-modal-footer">
      <a 
        id="preview-open-link" 
        href="#" 
        target="_blank" 
        rel="noopener noreferrer"
        class="preview-open-button"
      >
        Open in new tab
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M14 9v4a1 1 0 01-1 1H3a1 1 0 01-1-1V3a1 1 0 011-1h4M11 2h4v4M15 1L8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</div>

<style>
  /* ------------------------------------------------------------------ */
  /*  Modal overlay and backdrop                                         */
  /* ------------------------------------------------------------------ */

  .preview-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .preview-modal[aria-hidden="false"] {
    opacity: 1;
    pointer-events: auto;
  }

  .preview-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    cursor: pointer;
  }

  /* ------------------------------------------------------------------ */
  /*  Modal container                                                    */
  /* ------------------------------------------------------------------ */

  .preview-modal-container {
    position: relative;
    width: 90vw;
    max-width: 1400px;
    height: 85vh;
    background: var(--color-surface);
    border: 1px solid var(--color-contour);
    border-radius: var(--border-radius-lg);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
    display: flex;
    flex-direction: column;
    transform: scale(0.95);
    transition: transform 0.2s ease;
  }

  .preview-modal[aria-hidden="false"] .preview-modal-container {
    transform: scale(1);
  }

  /* ------------------------------------------------------------------ */
  /*  Modal header                                                       */
  /* ------------------------------------------------------------------ */

  .preview-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-md) var(--space-lg);
    border-bottom: 1px solid var(--color-contour);
    flex-shrink: 0;
  }

  .preview-modal-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
    margin: 0;
  }

  .preview-modal-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--color-contour);
    border-radius: var(--border-radius-sm);
    color: var(--color-text);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .preview-modal-close:hover {
    background: var(--color-surface-raised);
    border-color: var(--color-ink);
    color: var(--color-ink);
  }

  .preview-modal-close:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* ------------------------------------------------------------------ */
  /*  Modal body with iframe                                             */
  /* ------------------------------------------------------------------ */

  .preview-modal-body {
    position: relative;
    flex: 1;
    overflow: hidden;
    background: var(--color-surface-inset);
  }

  .preview-iframe {
    width: 100%;
    height: 100%;
    border: none;
    background: white;
  }

  /* ------------------------------------------------------------------ */
  /*  Loading state                                                      */
  /* ------------------------------------------------------------------ */

  .preview-modal-loading {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    background: var(--color-surface-inset);
    z-index: 1;
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  .preview-modal-loading[data-loading="false"] {
    opacity: 0;
    pointer-events: none;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--color-contour);
    border-top-color: var(--color-accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .loading-text {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }

  /* ------------------------------------------------------------------ */
  /*  Modal footer                                                       */
  /* ------------------------------------------------------------------ */

  .preview-modal-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: var(--space-md) var(--space-lg);
    border-top: 1px solid var(--color-contour);
    flex-shrink: 0;
  }

  .preview-open-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-md);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-contour);
    border-radius: var(--border-radius-sm);
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    color: var(--color-text);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .preview-open-button:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: white;
  }

  .preview-open-button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* ------------------------------------------------------------------ */
  /*  Responsive adjustments                                             */
  /* ------------------------------------------------------------------ */

  @media (max-width: 768px) {
    .preview-modal-container {
      width: 95vw;
      height: 90vh;
    }

    .preview-modal-header,
    .preview-modal-footer {
      padding: var(--space-sm) var(--space-md);
    }
  }
</style>
